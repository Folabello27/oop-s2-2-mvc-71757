@model oop_s2_2_mvc_71757.Models.FollowUp

@{
    ViewData["Title"] = "Edit Follow-up";
}

<h1>Edit Follow-up</h1>

<div class="panel">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id"/>
    <div class="mb-3">
        <label asp-for="InspectionId" class="form-label"></label>
        <select asp-for="InspectionId" class="form-select" asp-items="ViewBag.InspectionId"></select>
        <span asp-validation-for="InspectionId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" class="form-control" type="date"/>
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<FollowUpStatus>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ClosedDate" class="form-label"></label>
        <input asp-for="ClosedDate" class="form-control" type="date"/>
        <span asp-validation-for="ClosedDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
