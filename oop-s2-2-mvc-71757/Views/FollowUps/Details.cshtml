@model oop_s2_2_mvc_71757.Models.FollowUp

@{
    ViewData["Title"] = "Follow-up Details";
}

<h1>Follow-up Details</h1>

<div class="panel">
    <dl class="row">
        <dt class="col-sm-3">Inspection</dt>
        <dd class="col-sm-9">#@Model.InspectionId</dd>
        <dt class="col-sm-3">Premises</dt>
        <dd class="col-sm-9">@Model.Inspection?.Premises?.Name</dd>
        <dt class="col-sm-3">Due Date</dt>
        <dd class="col-sm-9">@Model.DueDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Closed Date</dt>
        <dd class="col-sm-9">@(Model.ClosedDate?.ToString("yyyy-MM-dd") ?? "-")</dd>
    </dl>

    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>
