@model oop_s2_2_mvc_71757.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-up";
}

<h1>Delete Follow-up</h1>

<div class="panel">
    <h3>Are you sure you want to delete this follow-up?</h3>

    <dl class="row">
        <dt class="col-sm-3">Inspection</dt>
        <dd class="col-sm-9">#@Model.InspectionId</dd>
        <dt class="col-sm-3">Due Date</dt>
        <dd class="col-sm-9">@Model.DueDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id"/>
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
