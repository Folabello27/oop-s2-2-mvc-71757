@model IEnumerable<oop_s2_2_mvc_71757.Models.Inspection>

@{
    ViewData["Title"] = "Inspections";
}

<h1>Inspections</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Inspector"))
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Create Inspection</a>
    </p>
}

<table class="table table-striped">
    <thead>
    <tr>
        <th>Premises</th>
        <th>Date</th>
        <th>Score</th>
        <th>Outcome</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Premises?.Name</td>
            <td>@item.InspectionDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Score</td>
            <td>
                @{
                    var outcomeClass = item.Outcome == InspectionOutcome.Fail
                        ? "badge-soft badge-high"
                        : "badge-soft badge-low";
                }
                <span class="@outcomeClass">@item.Outcome</span>
            </td>
            <td class="table-actions">
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Inspector"))
                {
                    <span> | </span>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <span> | </span>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
