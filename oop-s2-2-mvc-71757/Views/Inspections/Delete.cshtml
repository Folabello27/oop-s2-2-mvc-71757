@model oop_s2_2_mvc_71757.Models.Inspection

@{
    ViewData["Title"] = "Delete Inspection";
}

<h1>Delete Inspection</h1>

<div class="panel">
    <h3>Are you sure you want to delete this inspection?</h3>

    <dl class="row">
        <dt class="col-sm-3">Premises</dt>
        <dd class="col-sm-9">@Model.Premises?.Name</dd>
        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.InspectionDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Outcome</dt>
        <dd class="col-sm-9">@Model.Outcome</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id"/>
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
