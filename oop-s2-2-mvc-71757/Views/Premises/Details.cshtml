@model oop_s2_2_mvc_71757.Models.Premises

@{
    ViewData["Title"] = "Premises Details";
}

<h1>Premises Details</h1>

<div class="panel">
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>
