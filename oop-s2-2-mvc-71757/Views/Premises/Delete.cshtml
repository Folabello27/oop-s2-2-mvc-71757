@model oop_s2_2_mvc_71757.Models.Premises

@{
    ViewData["Title"] = "Delete Premises";
}

<h1>Delete Premises</h1>

<div class="panel">
    <h3>Are you sure you want to delete this premises?</h3>

    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Town</dt>
        <dd class="col-sm-9">@Model.Town</dd>
        <dt class="col-sm-3">Risk Rating</dt>
        <dd class="col-sm-9">@Model.RiskRating</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id"/>
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
